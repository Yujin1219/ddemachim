# Copy to deploy/.env (ignored by Git), then replace placeholders.
WEB_IMAGE=ddemachim-web:vm-amd64
BACKEND_IMAGE=ddemachim-backend:vm-amd64
DB_IMAGE=postgis/postgis:18-3.6

# Local default. For the VM, use its reachable interface IP or 0.0.0.0,
# and the port agreed with the company proxy administrator.
WEB_BIND_IP=127.0.0.1
WEB_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080

DB_PASSWORD=replace-with-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
KAKAO_REST_API_KEY=replace-with-server-key
TMAP_APP_KEY=replace-with-server-key
ODSAY_API_KEY=replace-with-server-key
AI_GUIDE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
SEOUL_CITYDATA_ENABLED=false
SEOUL_CITYDATA_API_KEY=
JAVA_TOOL_OPTIONS=-Xmx512m -Duser.timezone=Asia/Seoul
